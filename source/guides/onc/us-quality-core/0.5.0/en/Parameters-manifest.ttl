@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.org/guides/onc/us-quality-core/Parameters/manifest> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "manifest"] ; # 
  fhir:language [ fhir:v "en"] ; # 
  fhir:parameter ( [
     fhir:name [ fhir:v "system-version" ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "http://snomed.info/sct|http://snomed.info/sct/731000124108"^^xsd:anyURI ;
       fhir:l <http://snomed.info/sct?version=http://snomed.info/sct/731000124108>
     ]
  ] [
     fhir:name [ fhir:v "system-version" ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActCode|10.0.0"^^xsd:anyURI ;
       fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActCode?version=10.0.0>
     ]
  ] [
     fhir:name [ fhir:v "system-version" ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus|4.0.0"^^xsd:anyURI ;
       fhir:l <http://terminology.hl7.org/CodeSystem/v3-MaritalStatus?version=4.0.0>
     ]
  ] ) . # 

