deSystem/medicationdispense-status&quot;, &quot;version&quot;: &quot;4.0.1&quot;, &quot;code&quot;: &quot;cancelled&quot;, &quot;display&quot;: &quot;Cancelled&quot;}\" title=\"Click to Copy as Coding\" class=\"btn-copy\"> </button></span></td><td><span class=\"copy-text-inline\"><button data-clipboard-text=\"&lt;coding&gt;&lt;system value=&quot;http://terminology.hl7.org/CodeSystem/medicationdispense-status&quot;&gt;&lt;version value=&quot;4.0.1&quot;&gt;&lt;code value=&quot;cancelled&quot;&gt;&lt;display value=&quot;Cancelled&quot;&gt;&lt;/coding&gt;\" title=\"Click to Copy as Coding\" class=\"btn-copy\"> </button></span></td></tr><tr><td><a name=\"x-http://terminology.hl7.org/CodeSystem/medicationdispense-status-on-hold\"> </a><code>http://terminology.hl7.org/CodeSystem/medicationdispense-status</code></td><td style=\"white-space:nowrap\">\u00a0\u00a0<a href=\"http://hl7.org/fhir/R4/codesystem-medicationdispense-status.html#medicationdispense-status-on-hold\">on-hold</a></td><td>On Hold</td><td>The dispense process is paused while waiting for an external event to reactivate the dispense.  For example, new stock has arrived or the prescriber has called.</td><td><span class=\"copy-text-inline\"><button data-clipboard-text=\"{&quot;system&quot;: &quot;http://terminology.hl7.org/CodeSystem/medicationdispense-status&quot;, &quot;version&quot;: &quot;4.0.1&quot;, &quot;code&quot;: &quot;on-hold&quot;, &quot;display&quot;: &quot;On Hold&quot;}\" title=\"Click to Copy as Coding\" class=\"btn-copy\"> </button></span></td><td><span class=\"copy-text-inline\"><button data-clipboard-text=\"&lt;coding&gt;&lt;system value=&quot;http://terminology.hl7.org/CodeSystem/medicationdispense-status&quot;&gt;&lt;version value=&quot;4.0.1&quot;&gt;&lt;code value=&quot;on-hold&quot;&gt;&lt;display value=&quot;On Hold&quot;&gt;&lt;/coding&gt;\" title=\"Click to Copy as Coding\" class=\"btn-copy\"> </button></span></td></tr><tr><td><a name=\"x-http://terminology.hl7.org/CodeSystem/medicati