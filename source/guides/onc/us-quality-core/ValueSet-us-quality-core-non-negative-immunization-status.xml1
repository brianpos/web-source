<?xml version="1.0" encoding="UTF-8"?>

<ValueSet xmlns="http://hl7.org/fhir">
  <id value="us-quality-core-non-negative-immunization-status"/>
  <text>
    <status value="extensions"/><div xmlns="http://www.w3.org/1999/xhtml"><p class="res-header-id"><b>Generated Narrative: ValueSet us-quality-core-non-negative-immunization-status</b></p><a name="us-quality-core-non-negative-immunization-status"> </a><a name="hcus-quality-core-non-negative-immunization-status"> </a><ul><li>Include these codes as defined in <a href="http://hl7.org/fhir/R4/codesystem-event-status.html"><code>http://hl7.org/fhir/event-status</code></a><span title="Version is not explicitly stated, which means it is fixed to 4.0.1, the version found through the package references"> version &#x1F4E6;4.0.1</span><table class="none"><tr><td style="white-space:nowrap"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href="http://hl7.org/fhir/R4/codesystem-event-status.html#event-status-completed">completed</a></td><td>Completed</td><td>The event has now concluded.</td></tr><tr><td><a href="http://hl7.org/fhir/R4/codesystem-event-status.html#event-status-entered-in-error">entered-in-error</a></td><td>Entered in Error</td><td>This electronic record should never have existed, though it is possible that real-world decisions were based on it.  (If real-world activity has occurred, the status should be &quot;stopped&quot; rather than &quot;entered-in-error&quot;.).</td></tr></table></li></ul></div>
  </text>
  <url value="http://fhir.org/guides/onc/us-quality-core/ValueSet/us-quality-core-non-negative-immunization-status"/>
  <version value="0.5.0"/>
  <name value="NonNegativeImmunizationStatus"/>
  <title value="Non-Negative Immunization Status"/>
  <status value="active"/>
  <experimental value="false"/>
  <date value="2026-06-05"/>
  <publisher value="Office of the National Coordinator for Health Information Technology (ONC)"/>
  <contact>
    <name value="Office of the National Coordinator for Health Information Technology (ONC)"/>
    <telecom>
      <system value="url"/>
      <value value="https://www.healthit.gov/feedback"/>
    </telecom>
  </contact>
  <description value="This value set defines the set of codes that indicate a non-negated event status for immunization resources (i.e. codes that are not `not-done`)"/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="US"/>
      <display value="United States of America"/>
    </coding>
    <text value="USA"/>
  </jurisdiction>
  <purpose value="This value set was defined to support the set of event statuses in FHIR that do not explicitly indicate a negative status (i.e. all the codes from the http://hl7.org/fhir/event-status code system that are used for immunization status and that are not `not-done`)."/>
  <compose>
    <include>
      <system value="http://hl7.org/fhir/event-status"/>
      <concept>
        <code value="completed"/>
        <display value="Completed"/>
      </concept>
      <concept>
        <code value="entered-in-error"/>
        <display value="Entered in Error"/>
      </concept>
    </include>
  </compose>
</ValueSet>