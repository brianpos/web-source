  <differential>
    <element id="Communication">
      <path value="Communication"/>
      <constraint>
        <key value="cnd-1"/>
        <severity value="error"/>
        <human value="to indicate what communication was not carried out, either at least one coding in the topic or a notDoneValueSet extension shall be provided"/>
        <expression value="topic.extension('http://fhir.org/guides/onc/us-quality-core/StructureDefinition/us-quality-core-notDoneValueSet').exists() xor topic.coding.exists()"/>
