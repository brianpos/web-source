       fhir:reference [
         fhir:l <http://fhir.org/guides/onc/us-quality-core/StructureDefinition/us-quality-core-observation-clinical-result> ;
         fhir:reference [ fhir:v "StructureDefinition/us-quality-core-observation-clinical-result" ]
       ] ;
       fhir:name [ fhir:v "US Quality Core Observation Clinical Result" ] ;
       fhir:description [ fhir:v "The US Quality Core Observation Clinical Result Profile is based upon the US Core Observation Clinical Result Profile. Clinical results includes non-imaging and non-laboratory tests performed on a patient that results in structured or unstructured (narrative) findings specific to the patient, such as electrocardiogram (ECG), visual acuity exam, macular exam, or graded exercise testing (GXT), to facilitate the diagnosis and management of conditions. The US Quality Core Observation Clinical Result Profile profile defines the core set of elements and extensions for quality rule and measure authors." ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
