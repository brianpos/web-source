                </td>
                <td style="white-space:nowrap">  
                  <a href="http://terminology.hl7.org/7.1.0/CodeSystem-presentOnAdmission.html#presentOnAdmission-N">N</a>
                </td>
                <td>No</td>
                <td>Diagnosis was not present at time of inpatient admission.</td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="{&quot;system&quot;: &quot;https://www.cms.gov/Medicare/Medicare-Fee-for-Service-Payment/HospitalAcqCond/Coding&quot;, &quot;version&quot;: &quot;07/14/2020&quot;, &quot;code&quot;: &quot;N&quot;, &quot;display&quot;: &quot;No&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
                <td>
                  <span class="copy-text-inline">
                    <button data-clipboard-text="&lt;coding&gt;&lt;system value=&quot;https://www.cms.gov/Medicare/Medicare-Fee-for-Service-Payment/HospitalAcqCond/Coding&quot;&gt;&lt;version value=&quot;07/14/2020&quot;&gt;&lt;code value=&quot;N&quot;&gt;&lt;display value=&quot;No&quot;&gt;&lt;/coding&gt;" title="Click to Copy as Coding" class="btn-copy"> </button>
                  </span>
                </td>
